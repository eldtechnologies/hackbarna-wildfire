{
  "name": "ojo-de-fuego",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time wildfire intelligence console for Spain - HackBarna 2026",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "node --test --import tsx server/providers/normalize.test.ts server/providers/live.test.ts"
  },
  "dependencies": {
    "@turf/along": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/point-to-line-distance": "^7.4.0",
    "@turf/union": "^7.4.0",
    "cesium": "1.145.0",
    "express": "4.22.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "concurrently": "9.2.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-cesium": "1.2.23"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
