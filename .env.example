# Copy to .env. Every value is optional except DEEPFIRE_API_KEY for live mode.
#   cp .env.example .env

# live | replay. Default replay: works with no key and no network.
DATA_MODE=replay

# Deepfire OGC API Features. Override only for a mirror.
DEEPFIRE_BASE_URL=https://api.deepfire.co

# Required for DATA_MODE=live. The server reads ONLY this variable and sends it as
# "Authorization: Bearer". There is no token exchange in this repo: the API issues a
# ~180-day access_token from a client_id/client_secret pair, so exchange the pair
# yourself and put the resulting token here. See the README's "Deepfire credentials".
# An empty value in live mode throws on the first request and the server answers from
# replay instead, with provenance "replay". Never commit this value.
DEEPFIRE_API_KEY=

# Hosts the Deepfire base URL may point at, comma-separated. Default api.deepfire.co.
# A base URL on a host outside this list fails on the first live request and the server
# answers from replay, so it does not stop the process. Set this alongside
# DEEPFIRE_BASE_URL when pointing at a mirror.
#DEEPFIRE_ALLOWED_HOSTS=api.deepfire.co

# Live query window as west,south,east,north. Default is the Iberian Peninsula.
DEEPFIRE_BBOX=-10,35,4,44

# Hours of hotspot history to request in live mode. One day per upstream request.
DEEPFIRE_WINDOW_HOURS=24

# Return only what the API marks active. Off means every detection it still holds.
DEEPFIRE_ACTIVE_ONLY=true

# Snapshot file in data/snapshots/ used by replay mode.
# Default: los-gallardos-2026-07-09.json (the real Los Gallardos fire, 9-11 Jul 2026)
#REPLAY_SNAPSHOT=los-gallardos-2026-07-09.json

# Express proxy port.
#PORT=3001

# Interface to bind. Default 127.0.0.1 (loopback only). /api/fires spends the
# Deepfire quota, so expose it on the LAN only deliberately.
#HOST=0.0.0.0

# Where the recommendation ledger is appended. Default data/ledger/recommendations.jsonl.
# A deployment that must keep the record across restarts points this at a durable volume.
# The server refuses to start if the path is unusable, rather than serving without a
# record of what it advised.
#LEDGER_PATH=data/ledger/recommendations.jsonl

# OpenCelliD API token (opencellid.org). Read ONLY by scripts/fetch-reach.mjs: the served
# footprints are a committed fixture under data/reach/, never a request-path call, so the
# running server does not read this. Re-run the script to refresh the fixture.
# Never commit this value.
OPENCELLID_TOKEN=

# Optional chat-completions model for the situation narrator. It may only return an
# ordering of fact IDs the server supplied; it never writes factual prose. Leave the key
# empty and the report uses the deterministic order with no model call at all.
# The provider must support max_completion_tokens.
#LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
#LLM_API_KEY=
#LLM_MODEL=<model-id-enabled-on-your-provider-account>

# Directory of prepared native-grid thermal forecasts. Unset serves an empty list and a
# 404 on lookup, never an error. Set to data/forecasts/example for the committed example.
#FORECAST_DIR=data/forecasts/example

# OpenCelliD base URL. Override only for a mirror.
#OPENCELLID_BASE_URL=https://opencellid.org
