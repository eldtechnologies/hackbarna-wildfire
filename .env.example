# Copy to .env. Every value is optional except DEEPFIRE_API_KEY for live mode.
#   cp .env.example .env

# live | replay. Default replay: works with no key and no network.
DATA_MODE=replay

# Deepfire OGC API Features. Override only for a mirror.
DEEPFIRE_BASE_URL=https://api.deepfire.co

# Required for DATA_MODE=live. Create one at app.deepfire.co/settings/api-clients.
# Never commit this value.
DEEPFIRE_API_KEY=

# Live query window as west,south,east,north. Default is the Iberian Peninsula.
DEEPFIRE_BBOX=-10,35,4,44

# Hours of hotspot history to request in live mode. One day per upstream request.
DEEPFIRE_WINDOW_HOURS=24

# Return only what the API marks active. Off means every detection it still holds.
DEEPFIRE_ACTIVE_ONLY=true

# Snapshot file in data/snapshots/ used by replay mode.
# Default: los-gallardos-2026-07-09.json (the real Los Gallardos fire, 9-11 Jul 2026)
#REPLAY_SNAPSHOT=los-gallardos-2026-07-09.json

# Express proxy port.
#PORT=3001

# Interface to bind. Default 127.0.0.1 (loopback only). /api/fires spends the
# Deepfire quota, so expose it on the LAN only deliberately.
#HOST=0.0.0.0

# Where the recommendation ledger is appended. Default data/ledger/recommendations.jsonl.
# A deployment that must keep the record across restarts points this at a durable volume.
# The server refuses to start if the path is unusable, rather than serving without a
# record of what it advised.
#LEDGER_PATH=data/ledger/recommendations.jsonl
